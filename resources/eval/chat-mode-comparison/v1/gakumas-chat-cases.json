      "requiredTerms": ["4月2日", "6月3日", "152cm", "162cm", "45kg", "51kg", "所有运动", "唱歌"],
      "minImageCount": 0,
      "notes": "两角色结构化对比。观察 Agent 是否比 RAG 更稳定覆盖两份资料。"
    },
