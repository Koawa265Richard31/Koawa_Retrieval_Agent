{
  "schemaVersion": "1.0",
  "dataset": "gakumas-gamekee-characters-chat-mode-comparison",
  "description": "学园偶像大师 GameKee 角色 KB 的 RAG 与完整 Agent loop 对照测试集。评估最终聊天回答，不评估 /rag/eval 检索接口。",
  "modes": ["RAG", "AGENT"],
  "globalChecks": {
    "mustFinish": true,
    "mustNotAskClarification": true
  },
  "cases": [
    {
      "id": "profile-single-saki-all",
      "category": "single_profile",
      "difficulty": "easy",
      "agentExpectedValue": "none",
      "question": "花海咲季该角色所有资料",
      "expectedEntities": ["花海咲季"],
      "requiredTerms": ["4月2日", "16", "152cm", "45kg", "A", "左手", "爱知县", "所有运动", "長月あおい", "小火龙"],
      "minImageCount": 3,
      "notes": "单跳角色资料。RAG 应该完成；Agent 不应引入澄清或丢图。"
    },
    {
      "id": "profile-single-temari-all",
      "category": "single_profile",
      "difficulty": "easy",
      "agentExpectedValue": "none",
      "question": "月村手毬该角色所有资料，图片也要返回",
