# Copy to deploy/.env and replace every change-me value. Never commit deploy/.env.
SILICONFLOW_API_KEY=change-me
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

POSTGRES_DB=ragent
POSTGRES_USER=ragent
POSTGRES_PASSWORD=change-me-postgres
ADMIN_PASSWORD=change-me-admin
REDIS_PASSWORD=change-me-redis
RUSTFS_ACCESS_KEY=ragentadmin
RUSTFS_SECRET_KEY=change-me-rustfs

# Windows example: D:/ragent-runtime-data
# Linux example: /opt/ragent/data
RAGENT_DATA_ROOT=./runtime

APP_BIND_ADDRESS=0.0.0.0
APP_PORT=9090

# Keep Agent off for the first RAG smoke test, then enable a small rollout.
AGENT_ENABLED=false
AGENT_ROLLOUT_PERCENTAGE=0
AGENT_MAX_STEPS=8
AGENT_TURN_TIMEOUT=120s

# Keep the authenticated evaluation endpoint disabled outside isolated test runs.
APP_EVAL_ENABLED=false

# AR3 routing: off keeps single-pass, shadow compares in background, active may enhance answers.
RAG_AGENTIC_RETRIEVAL_MODE=off
RAG_AGENTIC_RETRIEVAL_ROLLOUT_PERCENTAGE=0
RAG_AGENTIC_RETRIEVAL_SHADOW_ENABLED=false
RAG_AGENTIC_RETRIEVAL_EVALUATOR_TIMEOUT=8s
RAG_AGENTIC_RETRIEVAL_PLANNER_TIMEOUT=8s
RAG_AGENTIC_RETRIEVAL_TIMEOUT=8s
RAG_AGENTIC_RETRIEVAL_MAX_ITERATIONS=2
RAG_AGENTIC_RETRIEVAL_MAX_SUB_QUERIES=6
RAG_AGENTIC_RETRIEVAL_MAX_RETRIEVED_CHUNKS=40
RAG_AGENTIC_RETRIEVAL_FULL_DOCUMENT_EXPANSION_ENABLED=true
RAG_AGENTIC_RETRIEVAL_MAX_FULL_DOCUMENT_CHARS=12000
